<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp">

    <TextView
        style="@style/Text.Anishot.Kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Дневник" />

    <TextView
        style="@style/Text.Anishot.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Мой список"
        android:textSize="34sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="128dp" />

        <LinearLayout
            android:id="@+id/groupEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="120dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageEmpty"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:contentDescription="@string/tab_list"
                android:scaleType="centerCrop"
                android:src="@drawable/art_onb_list" />

            <TextView
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
